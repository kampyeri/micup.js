{
    "name": "micup.js",
    "version": "0.8.0",
    "description": "Micup (Fluxer tabanlı) bot kütüphanesi: gateway, REST, mesaj olayları ve ses kanalında ses çalma. discord.js benzeri kullanım.",
    "main": "micup.js",
    "module": "micup.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./micup.js",
            "default": "./micup.js"
        },
        "./voice": {
            "types": "./voice.d.ts",
            "import": "./voice.js",
            "default": "./voice.js"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "files": [
        "micup.js",
        "components.js",
        "voice.js",
        "index.d.ts",
        "voice.d.ts",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test test/",
        "example": "node example/ping.js"
    },
    "keywords": [
        "micup",
        "fluxer",
        "discord",
        "bot",
        "gateway",
        "websocket",
        "voice",
        "livekit",
        "components",
        "buttons",
        "select-menu",
        "pagination"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kampyeri/micup.js.git"
    },
    "homepage": "https://github.com/kampyeri/micup.js#readme",
    "bugs": {
        "url": "https://github.com/kampyeri/micup.js/issues"
    },
    "author": "DCSV (https://dcsv.me)",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "dotenv": "^16.4.1",
        "@livekit/rtc-node": "1.1.0"
    },
    "peerDependencies": {
        "@livekit/rtc-node": "^1.1.0",
        "ffmpeg-static": "^5.2.0"
    },
    "peerDependenciesMeta": {
        "@livekit/rtc-node": {
            "optional": true
        },
        "ffmpeg-static": {
            "optional": true
        }
    },
    "contributors": [
        "kampyeri"
    ]
}
